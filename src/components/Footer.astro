---
import { SITE_NAME, SOCIAL_LINKS } from "../data/site";

const visibleLinks = SOCIAL_LINKS.filter((link) => link.url !== "");
const year = new Date().getFullYear();
---

<footer class="border-t border-neutral-200 bg-neutral-50">
  <div
    class="mx-auto flex max-w-5xl flex-col items-center gap-4 px-4 py-8 sm:flex-row sm:justify-between sm:px-6"
  >
    <p class="text-sm text-neutral-500">
      &copy; {year} {SITE_NAME}. All rights reserved.
    </p>
    {
      visibleLinks.length > 0 && (
        <ul class="flex items-center gap-5 text-sm">
          {visibleLinks.map((link) => (
            <li>
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-neutral-500 transition-colors hover:text-dawn-600"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>
