---
import { getCollection } from "astro:content";
import Base from "./Base.astro";

interface Props {
  title: string;
  description?: string;
  currentId: string;
}

const { title, description, currentId } = Astro.props;

const pages = (await getCollection("help")).sort(
  (a, b) => a.data.order - b.data.order,
);

/** index.md は /help/tango-note/ に、それ以外はスラッグページに対応させる */
const hrefOf = (id: string) =>
  id === "index" ? "/help/tango-note/" : `/help/tango-note/${id}/`;
---

<Base title={title} description={description}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-16">
    <p class="text-sm text-neutral-500">
      <a href="/products/tango-note/" class="hover:text-dawn-600">Tango Note</a>
      <span class="mx-2">/</span>
      <span>ヘルプ</span>
    </p>

    {/* モバイル: 上部アコーディオン */}
    <details
      class="mt-6 rounded-lg border border-neutral-200 bg-neutral-50 lg:hidden"
    >
      <summary
        class="cursor-pointer list-none px-4 py-3 text-sm font-bold text-neutral-800 marker:content-none"
      >
        <span class="inline-flex w-full items-center justify-between">
          ヘルプ目次
          <span aria-hidden="true" class="text-dawn-600">▾</span>
        </span>
      </summary>
      <nav aria-label="ヘルプ目次">
        <ul class="border-t border-neutral-200 py-2">
          {
            pages.map((page) => (
              <li>
                <a
                  href={hrefOf(page.id)}
                  aria-current={page.id === currentId ? "page" : undefined}
                  class:list={[
                    "block px-4 py-2 text-sm transition-colors",
                    page.id === currentId
                      ? "font-bold text-dawn-600"
                      : "text-neutral-600 hover:text-dawn-600",
                  ]}
                >
                  {page.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <div class="mt-8 lg:grid lg:grid-cols-[15rem_1fr] lg:gap-12">
      {/* デスクトップ: 左サイドバー */}
      <aside class="hidden lg:block">
        <nav aria-label="ヘルプ目次" class="sticky top-8">
          <p
            class="text-xs font-bold tracking-wider text-neutral-400 uppercase"
          >
            Tango Note ヘルプ
          </p>
          <ul class="mt-4 space-y-1 border-l border-neutral-200">
            {
              pages.map((page) => (
                <li>
                  <a
                    href={hrefOf(page.id)}
                    aria-current={page.id === currentId ? "page" : undefined}
                    class:list={[
                      "-ml-px block border-l-2 py-2 pl-4 text-sm transition-colors",
                      page.id === currentId
                        ? "border-dawn-600 font-bold text-dawn-600"
                        : "border-transparent text-neutral-600 hover:border-dawn-300 hover:text-dawn-600",
                    ]}
                  >
                    {page.data.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </aside>

      <article class="help-prose min-w-0">
        <h1 class="text-3xl font-bold text-neutral-900">{title}</h1>
        {
          description && (
            <p class="mt-4 text-lg leading-relaxed text-neutral-600">
              {description}
            </p>
          )
        }
        <div class="mt-8 border-t border-neutral-200 pt-8">
          <slot />
        </div>
      </article>
    </div>
  </div>
</Base>

<style is:global>
  .help-prose h2 {
    margin: 2.5rem 0 1rem;
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-neutral-900);
  }
  .help-prose h3 {
    margin: 2rem 0 0.75rem;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-neutral-900);
  }
  .help-prose p {
    margin: 1rem 0;
    line-height: 1.9;
    color: var(--color-neutral-700);
  }
  .help-prose ul,
  .help-prose ol {
    margin: 1rem 0;
    padding-left: 1.5rem;
    line-height: 1.9;
    color: var(--color-neutral-700);
  }
  .help-prose ul {
    list-style: disc;
  }
  .help-prose ol {
    list-style: decimal;
  }
  .help-prose li + li {
    margin-top: 0.5rem;
  }
  .help-prose a {
    color: var(--color-dawn-600);
    text-decoration: underline;
  }
  .help-prose a:hover {
    color: var(--color-dawn-700);
  }
  .help-prose strong {
    font-weight: 700;
    color: var(--color-neutral-900);
  }
  .help-prose code {
    border-radius: 0.25rem;
    background: var(--color-neutral-100);
    padding: 0.125rem 0.375rem;
    font-size: 0.875em;
    color: var(--color-neutral-800);
    overflow-wrap: anywhere;
  }
  /* コードブロックは自身の中で横スクロールさせる（ページ本体は横スクロールさせない） */
  .help-prose pre {
    margin: 1.5rem 0;
    overflow-x: auto;
    border: 1px solid var(--color-neutral-200);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    font-size: 0.8125rem;
    line-height: 1.8;
  }
  .help-prose pre code {
    background: none;
    padding: 0;
    font-size: inherit;
    color: inherit;
    overflow-wrap: normal;
  }
  .help-prose img {
    margin: 1.5rem 0;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--color-neutral-200);
    border-radius: 0.5rem;
  }
  .help-prose hr {
    margin: 2.5rem 0;
    border-color: var(--color-neutral-200);
  }
  /* 表は自身の中で横スクロールさせる（ページ本体は横スクロールさせない）。
     ラッパー要素を挟まずに済むよう table 自体をブロック化してスクロールさせる。 */
  .help-prose table {
    display: block;
    margin: 1.5rem 0;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.875rem;
    line-height: 1.7;
  }
  .help-prose th,
  .help-prose td {
    border: 1px solid var(--color-neutral-200);
    padding: 0.625rem 0.875rem;
    text-align: left;
    vertical-align: top;
  }
  .help-prose th {
    background: var(--color-neutral-50);
    font-weight: 700;
    color: var(--color-neutral-900);
    white-space: nowrap;
  }
  .help-prose td {
    color: var(--color-neutral-700);
  }
  .help-prose td code,
  .help-prose th code {
    white-space: nowrap;
  }
</style>
